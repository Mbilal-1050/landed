# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to browser

# Whop — Dashboard > Developer > Webhooks
WHOP_WEBHOOK_SECRET=your-whop-webhook-secret
NEXT_PUBLIC_WHOP_PRO_LINK=https://whop.com/checkout/your-pro-plan
NEXT_PUBLIC_WHOP_BUSINESS_LINK=https://whop.com/checkout/your-business-plan

# Anthropic — console.anthropic.com > API Keys. Powers the AI resume/cover letter builder.
ANTHROPIC_API_KEY=

# Your deployed site URL, used to build referral links
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
